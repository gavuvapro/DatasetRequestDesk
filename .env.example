# ---- Dataset Request Desk configuration -------------------------------------
# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection string.
# Local Docker (default): points at the `db` service started by docker compose.
DATABASE_URL=postgresql+psycopg2://drd:drd@db:5432/dataset_request_desk

# Neon PostgreSQL: copy the connection string from the Neon dashboard and make
# sure it uses the `postgresql+psycopg2://` (or `postgresql://`) scheme, e.g.:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@ep-cool-name-123.eu-central-1.aws.neon.tech/neondb?sslmode=require

# JWT settings
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Seed / bootstrap
SEED_USERS_FILE=seed/users.json
DEFAULT_ADMIN_PASSWORD=admin123

# Logging: "json" (structured, default) or "text" (human readable)
LOG_FORMAT=json
LOG_LEVEL=INFO

# Ports exposed by docker compose
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
